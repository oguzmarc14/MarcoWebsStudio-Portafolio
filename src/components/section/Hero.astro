---
import { whatsappUrl } from '../../data/landing';
const pillars=[
 ['fa-code','Software a medida','Soluciones diseñadas para tu operación.'],
 ['fa-gears','Automatización','Procesos más simples. Resultados más grandes.'],
 ['fa-chart-simple','Inteligencia aplicada','El poder de la IA en tu negocio.']
];
---
<header id="home" class="relative overflow-hidden bg-white pt-24 lg:pt-28">
  <div class="hero-wash absolute right-0 top-0 h-full w-[52%]"></div>
  <div class="mx-auto grid min-h-[660px] max-w-7xl items-center gap-10 px-4 pb-14 sm:px-6 lg:grid-cols-[1.03fr_.97fr] lg:px-8">
    <div class="relative z-10 py-8" data-reveal>
      <p class="mb-5 text-[11px] font-bold uppercase tracking-[.28em] text-blue-600 sm:text-xs">Software · Automatización · Tecnología</p>
      <h1 class="max-w-3xl text-5xl font-bold leading-[1.02] tracking-[-.045em] text-[#071a3d] sm:text-6xl lg:text-[4.35rem]">
        Tecnología que hace <span class="text-gradient-blue">avanzar</span> tu negocio.
      </h1>
      <p class="mt-6 max-w-xl text-base leading-7 text-slate-500 sm:text-lg">Desarrollamos software, sistemas y automatizaciones para empresas que quieren operar mejor, reducir tareas manuales y crecer con tecnología.</p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href={whatsappUrl} class="blue-button inline-flex items-center justify-center gap-3 rounded-full px-7 py-3.5 font-semibold"><i class="fa-brands fa-whatsapp"></i> Hablemos de tu proyecto <i class="fa-solid fa-arrow-right text-xs"></i></a>
        <a href="#proyectos" class="outline-button inline-flex items-center justify-center gap-3 rounded-full px-7 py-3.5 font-semibold">Ver proyectos <i class="fa-solid fa-arrow-right text-xs"></i></a>
      </div>
      <div class="mt-12 grid max-w-2xl grid-cols-1 gap-5 sm:grid-cols-3">
        {pillars.map(p => <div class="border-l border-slate-200 pl-4 first:border-l-0 first:pl-0">
          <i class={`fa-solid ${p[0]} mb-3 text-xl text-blue-600`}></i>
          <h3 class="text-sm font-bold text-[#071a3d]">{p[1]}</h3>
          <p class="mt-1 text-xs leading-5 text-slate-500">{p[2]}</p>
        </div>)}
      </div>
    </div>

    <div class="relative hidden min-h-[575px] lg:block" data-reveal>
      <div class="hero-ghost-a" aria-hidden="true">A</div>
      <div class="hero-a-wrap">
        <span class="avancia-mark hero-main-a"></span>
        <div class="hero-office-photo" aria-hidden="true"></div>
      </div>
      <div class="absolute right-2 top-[92px] space-y-2 text-[11px] font-semibold uppercase tracking-[.28em] text-slate-400">
        <p>Ideas</p><p>Procesos</p><p>Personas</p><p>Tecnología</p><p class="text-blue-600">Resultados</p>
        <span class="mt-5 block h-[2px] w-12 bg-blue-500"></span>
      </div>
      <div class="hero-handnote">Todo<br/>Avanza</div>
      <svg class="hero-note-arrow" viewBox="0 0 90 65" fill="none" aria-hidden="true">
        <path d="M84 9C51 7 22 22 18 53" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        <path d="M12 45L18 54L27 48" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>
  </div>
</header>