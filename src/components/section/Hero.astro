---
import { whatsappUrl } from '../../data/landing';
const pillars=[
 ['fa-code','Software a medida','Soluciones diseñadas para tu operación.'],
 ['fa-gears','Automatización','Procesos más simples. Resultados más grandes.'],
 ['fa-chart-simple','Inteligencia aplicada','El poder de la IA en tu negocio.']
];
---
<header id="home" class="relative overflow-hidden bg-white pt-28">
  <div class="absolute right-0 top-16 h-[34rem] w-[48%] bg-gradient-to-bl from-blue-50/90 via-sky-50/30 to-transparent"></div>
  <div class="mx-auto grid min-h-[650px] max-w-7xl items-center gap-12 px-4 pb-16 sm:px-6 lg:grid-cols-[1.05fr_.95fr] lg:px-8">
    <div class="relative z-10" data-reveal>
      <p class="mb-5 text-xs font-bold uppercase tracking-[.25em] text-blue-600">Software · Automatización · Tecnología</p>
      <h1 class="max-w-3xl text-5xl font-bold leading-[1.02] tracking-[-.04em] text-[#071a3d] sm:text-6xl lg:text-7xl">
        Tecnología que hace <span class="text-gradient-blue">avanzar</span> tu negocio.
      </h1>
      <p class="mt-6 max-w-xl text-base leading-7 text-slate-500 sm:text-lg">Desarrollamos software, sistemas y automatizaciones para empresas que quieren operar mejor, reducir tareas manuales y crecer con tecnología.</p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href={whatsappUrl} class="blue-button inline-flex items-center justify-center gap-3 rounded-full px-7 py-3.5 font-semibold"><i class="fa-brands fa-whatsapp"></i> Hablemos de tu proyecto <i class="fa-solid fa-arrow-right text-xs"></i></a>
        <a href="#proyectos" class="outline-button inline-flex items-center justify-center gap-3 rounded-full px-7 py-3.5 font-semibold">Ver proyectos <i class="fa-solid fa-arrow-right text-xs"></i></a>
      </div>
      <div class="mt-12 grid max-w-2xl grid-cols-1 gap-5 sm:grid-cols-3">
        {pillars.map(p => <div class="border-l border-slate-200 pl-4 first:border-l-0 first:pl-0">
          <i class={`fa-solid ${p[0]} mb-3 text-xl text-blue-600`}></i>
          <h3 class="text-sm font-bold text-[#071a3d]">{p[1]}</h3>
          <p class="mt-1 text-xs leading-5 text-slate-500">{p[2]}</p>
        </div>)}
      </div>
    </div>
    <div class="relative hidden min-h-[560px] lg:block" data-reveal>
      <div class="absolute left-1/2 top-1/2 h-[470px] w-[390px] -translate-x-1/2 -translate-y-1/2">
        <span class="avancia-mark avancia-mark-hero"></span>
        <div class="absolute bottom-10 left-16 right-0 h-40 overflow-hidden rounded-2xl border border-blue-100 bg-gradient-to-br from-slate-50 to-blue-50 shadow-xl">
          <div class="grid h-full place-items-center text-center">
            <div><i class="fa-solid fa-building text-4xl text-blue-500/40"></i><p class="mt-3 text-sm font-semibold text-slate-500">Ideas → procesos → tecnología → resultados</p></div>
          </div>
        </div>
      </div>
      <div class="absolute right-0 top-20 space-y-2 text-xs font-semibold uppercase tracking-[.25em] text-slate-400">
        <p>Ideas</p><p>Procesos</p><p>Personas</p><p>Tecnología</p><p class="text-blue-500">Resultados</p>
      </div>
    </div>
  </div>
</header>