---
import { projectItems } from '../../data/landing';
import SectionHeading from '../ui/SectionHeading.astro';
---
<section id="proyectos" class="bg-white px-4 py-24 sm:px-6 lg:px-8">
 <div class="mx-auto max-w-7xl">
  <SectionHeading eyebrow="Nuestros proyectos" title="Soluciones que generan resultados." description="Conservamos nuestros trabajos reales: cada proyecto muestra cómo la tecnología puede resolver una necesidad distinta." />
  <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
   {projectItems.map((p,i)=><article class="light-card overflow-hidden" data-reveal style={`--reveal-delay:${i*70}ms`}>
    <a href={p.href} target="_blank" rel="noopener noreferrer" class="block h-56 overflow-hidden bg-slate-100"><img src={p.image} alt={p.alt} class="h-full w-full object-cover transition duration-500 hover:scale-105" loading="lazy"/></a>
    <div class="p-5"><h3 class="font-bold text-[#071a3d]">{p.title}</h3><p class="mt-2 text-sm leading-6 text-slate-500">{p.description}</p><div class="mt-4 flex flex-wrap gap-2">{p.badges.map(b=><span class="rounded-full bg-blue-50 px-3 py-1 text-[11px] font-semibold text-blue-600">{b}</span>)}</div><a href={p.href} target="_blank" rel="noopener noreferrer" class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-blue-600">Ver proyecto <i class="fa-solid fa-arrow-right text-xs"></i></a></div>
   </article>)}
  </div>
 </div>
</section>