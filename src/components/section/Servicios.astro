---
import SectionHeading from '../ui/SectionHeading.astro';
const services=[
 ['fa-code','Software a medida','Sistemas, plataformas y aplicaciones diseñadas para tu operación.'],
 ['fa-gears','Automatización','Conectamos tus procesos, herramientas y datos para ahorrar tiempo y costos.'],
 ['fa-chart-simple','Inteligencia aplicada','Implementamos IA donde realmente genera valor en tu negocio.'],
 ['fa-layer-group','Desarrollo web','Sitios web y soluciones digitales modernas, rápidas y escalables.']
];
---
<section id="servicios" class="bg-[#fbfdff] px-4 py-24 sm:px-6 lg:px-8">
 <div class="mx-auto max-w-7xl">
  <div class="text-center"><p class="text-xs font-bold uppercase tracking-[.24em] text-blue-600">Nuestras soluciones</p><h2 class="mt-3 text-3xl font-bold text-[#071a3d] sm:text-5xl">Tecnología para hacer <span class="text-gradient-blue">avanzar tu negocio.</span></h2><p class="mt-4 text-slate-500">Convertimos procesos, ideas y oportunidades en soluciones que impulsan el avance de tu empresa.</p></div>
  <div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
   {services.map((s,i)=><article class="light-card p-7" data-reveal style={`--reveal-delay:${i*70}ms`}><div class="mb-6 flex h-12 w-12 items-center justify-center rounded-full bg-blue-50"><i class={`fa-solid ${s[0]} text-xl text-blue-600`}></i></div><h3 class="text-lg font-bold text-[#071a3d]">{s[1]}</h3><p class="mt-3 text-sm leading-6 text-slate-500">{s[2]}</p><a href="#contacto" class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-blue-600">Conocer más <i class="fa-solid fa-arrow-right text-xs"></i></a></article>)}
  </div>
  <div class="mt-10 grid overflow-hidden rounded-2xl border border-blue-100 bg-blue-50/50 sm:grid-cols-4">
   {[['+15','Proyectos realizados'],['100%','Soluciones a medida'],['24/7','Tecnología disponible'],['∞','Posibilidades de crecimiento']].map((x,i)=><div class="px-5 py-6 text-center sm:border-r sm:border-blue-100 sm:last:border-r-0"><p class="text-3xl font-bold text-blue-600">{x[0]}</p><p class="mt-1 text-xs text-slate-500">{x[1]}</p></div>)}
  </div>
 </div>
</section>