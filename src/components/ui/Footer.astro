---
import { socialLinks, whatsappUrl } from '../../data/landing';
---
<footer class="border-t border-slate-100 bg-white px-4 pb-8 pt-14 sm:px-6 lg:px-8">
 <div class="mx-auto max-w-7xl">
  <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
   <div><a href="#home" class="flex items-center gap-3"><span class="avancia-mark avancia-mark-sm"></span><span class="text-xl font-bold tracking-[.12em] text-[#061735]">AVANCIA</span></a><p class="mt-4 max-w-xs text-sm text-slate-500">Tecnología que hace avanzar tu negocio.</p><div class="mt-5 flex gap-3">{socialLinks.map(s=><a href={s.href} target="_blank" rel="noopener noreferrer" class="text-slate-500 hover:text-blue-600"><i class={s.label==='Instagram'?'fa-brands fa-instagram':s.label==='Facebook'?'fa-brands fa-facebook':'fa-brands fa-tiktok'}></i></a>)}<a href={whatsappUrl} class="text-slate-500 hover:text-blue-600"><i class="fa-brands fa-whatsapp"></i></a></div></div>
   <div><h3 class="font-bold text-[#071a3d]">Navegación</h3><div class="mt-4 space-y-2 text-sm text-slate-500"><a class="block hover:text-blue-600" href="#home">Inicio</a><a class="block hover:text-blue-600" href="#servicios">Servicios</a><a class="block hover:text-blue-600" href="#proyectos">Proyectos</a><a class="block hover:text-blue-600" href="#proceso">Proceso</a></div></div>
   <div><h3 class="font-bold text-[#071a3d]">Servicios</h3><div class="mt-4 space-y-2 text-sm text-slate-500"><p>Software a medida</p><p>Automatización</p><p>Inteligencia aplicada</p><p>Desarrollo web</p></div></div>
   <div><h3 class="font-bold text-[#071a3d]">Contacto</h3><div class="mt-4 space-y-3 text-sm text-slate-500"><a href={whatsappUrl} class="block hover:text-blue-600"><i class="fa-brands fa-whatsapp mr-2"></i>WhatsApp</a><p><i class="fa-solid fa-envelope mr-2"></i>Hablemos de tu proyecto</p></div></div>
  </div>
  <div class="mt-12 flex flex-col justify-between gap-3 border-t border-slate-100 pt-6 text-xs text-slate-400 sm:flex-row"><p>© {new Date().getFullYear()} AVANCIA. Todos los derechos reservados.</p><p class="uppercase tracking-[.15em]">Ideas · Procesos · Personas · Tecnología · Resultados</p></div>
 </div>
</footer>