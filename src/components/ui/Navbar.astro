---
import { navLinks, whatsappUrl } from '../../data/landing';
---
<nav id="main-navbar" class="fixed inset-x-0 top-0 z-50 border-b border-transparent bg-white/90 backdrop-blur-xl transition-all">
  <div class="mx-auto flex h-20 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <a href="#home" class="flex items-center gap-3">
      <span class="avancia-mark avancia-mark-sm" aria-hidden="true"></span>
      <span class="text-xl font-bold tracking-[.12em] text-[#061735]">AVANCIA</span>
    </a>
    <div class="hidden items-center gap-7 md:flex">
      {navLinks.map((item,index) => <a href={item.href} class={`relative text-sm font-medium transition hover:text-blue-600 ${index===0?'text-[#071a3d] after:absolute after:-bottom-3 after:left-0 after:h-[2px] after:w-full after:bg-blue-500':'text-slate-600'}`}>{item.label}</a>)}
    </div>
    <a href={whatsappUrl} class="blue-button inline-flex items-center gap-2 rounded-full px-5 py-2.5 text-sm font-semibold">
      <i class="fa-brands fa-whatsapp"></i><span class="hidden sm:inline">Hablemos</span>
    </a>
  </div>
</nav>