---
import { navLinks, whatsappUrl } from '../../data/landing';
---

<nav id="main-navbar" class="fixed inset-x-0 top-0 z-50 px-3 pt-3 sm:px-6 sm:pt-4 animate-fade-in">
    <div class="navbar-inner mx-auto flex max-w-7xl items-center justify-between rounded-2xl px-3 py-2.5 sm:px-4 sm:py-3 transition-all duration-500"
        style="background: rgba(5,8,22,0.68); backdrop-filter: blur(20px) saturate(1.5); border: 1px solid rgba(255,255,255,0.07); box-shadow: 0 8px 32px rgba(0,0,0,0.3), inset 0 1px 0 rgba(255,255,255,0.05);">

        <a href="#home" class="group flex items-center gap-3 text-white">
            <div class="relative flex h-10 w-10 items-center justify-center overflow-hidden rounded-xl"
                style="background: linear-gradient(135deg, #0b52ff 0%, #00d4ff 100%); box-shadow: 0 0 26px rgba(0,183,255,0.24);">
                <span class="text-sm font-black tracking-tight text-white">A</span>
                <span class="absolute left-2 top-2 h-5 w-5 rotate-45 border-l border-t border-white/30"></span>
            </div>
            <div class="leading-none">
                <p class="text-sm font-bold tracking-[0.16em] text-white sm:text-base">AVANCIA</p>
                <p class="mt-1 hidden text-[9px] font-medium uppercase tracking-[0.22em] text-slate-500 sm:block">Software · Automatización · Tecnología</p>
            </div>
        </a>

        <div class="hidden items-center gap-6 text-sm md:flex">
            {navLinks.map((item) => (
                <a class="nav-link relative text-slate-300/80 transition-colors duration-200 hover:text-white" href={item.href}>
                    {item.label}
                </a>
            ))}
        </div>

        <a href={whatsappUrl}
            class="premium-button inline-flex items-center gap-2 rounded-xl px-3 py-2 sm:px-4 text-sm font-semibold"
            aria-label="Hablar por WhatsApp">
            <i class="fa-brands fa-whatsapp text-base"></i>
            <span class="hidden sm:inline">Hablemos</span>
            <span class="sm:hidden">WhatsApp</span>
        </a>
    </div>
</nav>

<style>
    .nav-link::after {
        content: '';
        position: absolute;
        bottom: -2px;
        left: 0;
        width: 0;
        height: 1px;
        background: linear-gradient(90deg, #2563eb, #22d3ee);
        border-radius: 99px;
        transition: width 280ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    .nav-link:hover::after { width: 100%; }

    #main-navbar[data-scrolled] .navbar-inner {
        background: rgba(5,8,22,0.9) !important;
        box-shadow: 0 12px 48px rgba(0,0,0,0.45), 0 0 0 1px rgba(37,99,235,0.08), inset 0 1px 0 rgba(255,255,255,0.05) !important;
    }
</style>