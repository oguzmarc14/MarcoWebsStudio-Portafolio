---
interface Props { eyebrow:string; title:string; description?:string; }
const { eyebrow,title,description }=Astro.props as Props;
---
<div class="mb-12" data-reveal>
  <p class="mb-3 text-xs font-bold uppercase tracking-[.24em] text-blue-600">{eyebrow}</p>
  <h2 class="max-w-4xl text-3xl font-bold tracking-tight text-[#071a3d] sm:text-4xl lg:text-5xl">{title}</h2>
  {description && <p class="mt-4 max-w-2xl text-base leading-7 text-slate-500">{description}</p>}
</div>