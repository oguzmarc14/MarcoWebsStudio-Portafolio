<!doctype html><html lang="es"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="generator" content={Astro.generator}/><meta name="theme-color" content="#ffffff"/><meta name="description" content="AVANCIA desarrolla software, automatización y tecnología para hacer avanzar negocios."/><title>AVANCIA | Tecnología que hace avanzar tu negocio</title><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet"/><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/></head><body class="bg-white text-[#071a3d] antialiased"><slot/><script>const els=document.querySelectorAll('[data-reveal]');if('IntersectionObserver'in window){const o=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('is-visible');o.unobserve(e.target)}}),{threshold:.1});els.forEach(e=>o.observe(e))}else els.forEach(e=>e.classList.add('is-visible'));const n=document.querySelector('#main-navbar');window.addEventListener('scroll',()=>n?.classList.toggle('nav-scrolled',scrollY>30),{passive:true});</script></body></html>